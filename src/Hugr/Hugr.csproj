<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Hugr</AssemblyName>
    <RootNamespace>Hugr</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Every reference is read straight from the local install, so the versions always match
    the game being modded. Set VALHEIM_INSTALL to the folder containing valheim.exe.
  -->
  <PropertyGroup>
    <ValheimManaged>$(VALHEIM_INSTALL)\valheim_Data\Managed</ValheimManaged>
    <BepInExCore>$(VALHEIM_INSTALL)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <!--
    Private members of the game are reached in typed C# rather than through reflection: the
    publicizer rewrites assembly_valheim at build time, from the install, and Mono accepts the
    calls once unsafe blocks are allowed. A renamed member then breaks the build, not the game.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.2" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CheckValheimInstall" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(ValheimManaged)') OR !Exists('$(BepInExCore)')">
    <Error Text="VALHEIM_INSTALL must point at the Valheim folder containing valheim.exe, with BepInEx installed. Current value: '$(VALHEIM_INSTALL)'. See README.md." />
  </Target>

  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)\assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)\assembly_guiutils.dll" Private="false" />
    <Reference Include="gui_framework" HintPath="$(ValheimManaged)\gui_framework.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ValheimManaged)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!--
    <Version> above is the only place the version is written: this target turns it into
    BuildInfo.Version (X.Y.Z, what BepInPlugin needs: it parses it as a System.Version) and
    BuildInfo.DisplayVersion, shown in the settings tab and the log. A Debug build displays
    X.Y.Z-dev_N, where N counts the builds of this checkout in build.number (local, untracked).
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildNumberFile>$(MSBuildProjectDirectory)\build.number</BuildNumberFile>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="LastBuildNumber" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <LastBuildNumber Condition="'$(LastBuildNumber)' == ''">0</LastBuildNumber>
      <BuildNumber>$(LastBuildNumber)</BuildNumber>
      <BuildNumber Condition="'$(DesignTimeBuild)' != 'true'">$([MSBuild]::Add($(LastBuildNumber), 1))</BuildNumber>
      <DisplayVersion>$(Version)</DisplayVersion>
      <DisplayVersion Condition="'$(Configuration)' == 'Debug'">$(Version)-dev_$(BuildNumber)</DisplayVersion>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(BuildNumberFile)"
      Lines="$(BuildNumber)"
      Overwrite="true"
      Condition="'$(DesignTimeBuild)' != 'true'" />
    <WriteLinesToFile
      File="$(BuildInfoFile)"
      Lines="namespace Hugr { internal static class BuildInfo { internal const string Version = &quot;$(Version)&quot;%3B internal const string DisplayVersion = &quot;$(DisplayVersion)&quot;%3B } }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Debug builds land in the game. With -p:HotReload=true they go to BepInEx\scripts instead,
    where ScriptEngine reloads them in the running game (F6). The other location is cleared in
    the same step: the same plugin GUID loaded twice is a confusing failure.
  -->
  <PropertyGroup>
    <HugrPluginDir>$(VALHEIM_INSTALL)\BepInEx\plugins\Hugr</HugrPluginDir>
    <HugrScriptDir>$(VALHEIM_INSTALL)\BepInEx\scripts</HugrScriptDir>
    <HugrDeployDir Condition="'$(HotReload)' == 'true'">$(HugrScriptDir)</HugrDeployDir>
    <HugrDeployDir Condition="'$(HotReload)' != 'true'">$(HugrPluginDir)</HugrDeployDir>
  </PropertyGroup>

  <Target Name="DeployToValheim" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Delete Files="$(HugrPluginDir)\$(AssemblyName).dll" Condition="'$(HotReload)' == 'true'" />
    <Delete Files="$(HugrScriptDir)\$(AssemblyName).dll" Condition="'$(HotReload)' != 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HugrDeployDir)\" />
    <Message Importance="high" Text="Hugr deployed to $(HugrDeployDir)" />
  </Target>

</Project>
